# Copy the names into Vercel (Project > Settings > Environment Variables).
# For local dev, run `vercel env pull .env.local` after adding them there.
# Never commit real values.

# Claude API (from the Claude Console, platform.claude.com)
ANTHROPIC_API_KEY=
EXAMINER_MODEL=claude-haiku-4-5-20251001
GRADE_MODEL=claude-opus-5-5

# Access gate
# The passphrase Julio types once. Pick something easy to type.
APP_PASSPHRASE=
# Random 64-character hex string. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DAILY_SESSION_CAP=12

# Supabase (Project Settings > API Keys; use the secret key, never the publishable one, server side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Vercel Cron authorization (random string, same generator as SESSION_SECRET)
CRON_SECRET=
